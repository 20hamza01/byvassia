// VASSIA Candles & Scents — data model
// Postgres (Neon). Single connection: DATABASE_URL must be the DIRECT
// (non-pooled) Neon endpoint — its host has NO "-pooler" — so the app and
// `prisma db push` both work over it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  scentNotes  String // comma-separated, e.g. "Bergamot, Cedar, Amber"
  priceMAD    Int // whole dirham
  category    String   @default("CANDLE") // CANDLE | DIFFUSER | ACCESSORY
  images      String // JSON-encoded string array of image paths
  stock       Int      @default(0)
  status      String   @default("ACTIVE") // ACTIVE | DRAFT
  featured    Boolean  @default(false)
  weightG     Int? // optional fill weight in grams
  burnTime    String? // e.g. "40+ hours"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerName String
  phone        String
  email        String?
  city         String
  address      String
  notes        String?
  isGift       Boolean     @default(false)
  giftMessage  String?
  giftFeeMAD   Int         @default(0)
  subtotalMAD  Int
  deliveryMAD  Int         @default(0)
  totalMAD     Int
  status       String      @default("NEW") // NEW | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// Key/value store for app-level settings (e.g. admin password hash).
// Used so the admin can rotate their password from the UI — falls back to
// the ADMIN_PASSWORD env var when no row exists.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id           String  @id @default(cuid())
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  productId    String
  name         String
  unitPriceMAD Int
  qty          Int
  image        String?
}
