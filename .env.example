# --- VASSIA Candles & Scents — environment template ---
# Copy this file to ".env" and fill in real values.
# On Vercel, set all of these in Project → Settings → Environment Variables.

# --- Database: Neon Postgres ---
# Single connection. Use the DIRECT endpoint from the Neon dashboard
# (Connection Details) — its host has NO "-pooler" — so the app and
# `prisma db push` both work over it.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"

# --- Image storage: Vercel Blob ---
# Injected automatically on Vercel once a Blob store is connected.
# For local uploads: Vercel → Storage → Blob → copy the read-write token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# --- Admin ---
ADMIN_PASSWORD="choose-a-strong-password"
JWT_SECRET="generate-a-long-random-string"

# --- Public contact / social ---
# WhatsApp number, international format, digits only (Morocco: 2126XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER="2126XXXXXXXX"
NEXT_PUBLIC_INSTAGRAM="https://instagram.com/vassiacandles"
NEXT_PUBLIC_CONTACT_EMAIL="hello@vassiacandles.com"

# --- Order notification emails (Resend) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Where new-order notifications are sent (shop owner's inbox)
ORDER_NOTIFICATION_EMAIL="byvassia@gmail.com"
# Optional. The "From" address shown on notification emails. Defaults to
# Resend's shared sender, which ONLY delivers to the Resend account owner
# until you verify your own domain at https://resend.com/domains
# Once a domain is verified, set e.g. "VASSIA Orders <orders@vassiacandles.com>"
ORDER_NOTIFICATION_FROM="VASSIA Orders <onboarding@resend.dev>"
