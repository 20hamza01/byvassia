# --- VASSIA Candles & Scents — environment template ---
# Copy this file to ".env" and fill in real values.
# On Vercel, set all of these in Project → Settings → Environment Variables.

# --- Database: Neon Postgres ---
# DATABASE_URL = POOLED connection (host contains "-pooler"). Used by the app.
# DIRECT_URL   = DIRECT connection (no "-pooler"). Used by `prisma db push`.
# Both are shown in the Neon dashboard under Connection Details → Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"

# --- Image storage: Vercel Blob ---
# Injected automatically on Vercel once a Blob store is connected.
# For local uploads: Vercel → Storage → Blob → copy the read-write token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# --- Admin ---
ADMIN_PASSWORD="choose-a-strong-password"
JWT_SECRET="generate-a-long-random-string"

# --- Public contact / social ---
# WhatsApp number, international format, digits only (Morocco: 2126XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER="2126XXXXXXXX"
NEXT_PUBLIC_INSTAGRAM="https://instagram.com/vassiacandles"
NEXT_PUBLIC_CONTACT_EMAIL="hello@vassiacandles.com"
